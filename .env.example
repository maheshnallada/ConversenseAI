# Local SQLite development default
DATABASE_URL=sqlite:///./backend/conversense.sqlite3

# PostgreSQL deployment (Docker Compose or production)
# DATABASE_URL=postgresql+psycopg://conversense:conversense_secret@localhost:5432/conversense

# Artifact Storage directory
ARTIFACT_STORAGE_PATH=./backend/storage/artifacts

# Ingestion Tenant ID
TENANT_ID=health_campaign

# Use a Portkey gateway API key here (not an upstream provider key).
# The provider/model route must be enabled in the Portkey Model Catalog.
LLM_BASE_URL = https://api.portkey.ai/v1
LLM_API_KEY =
LLM_PROVIDER = groq
LLM_MODEL = openai/gpt-oss-120b